#!/usr/bin/python3.5
"""Private IPC client for ssh-add/ssh-keygen; contains no stored credentials."""
import os
import socket
import struct
import sys


def main():
    path = os.environ.get("ASTRATERM_ASKPASS_SOCKET", "")
    if not path:
        return 1
    stream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        request = os.environ.get("ASTRATERM_ASKPASS_REQUEST") == "1"
        stream.settimeout(125 if request else 10)
        stream.connect(path)
        if request:
            prompt = (sys.argv[1] if len(sys.argv) > 1 else "").encode("utf-8")
            if len(prompt) > 65536:
                return 1
            stream.sendall(struct.pack(">I", len(prompt)) + prompt)
        data = bytearray()
        while len(data) <= 262144:
            part = stream.recv(4096)
            if not part:
                break
            data.extend(part)
            if b"\n" in part:
                break
        if not data.endswith(b"\n") or b"\n" in data[:-1]:
            return 1
        sys.stdout.buffer.write(bytes(data))
        sys.stdout.buffer.flush()
        return 0
    except Exception:
        return 1
    finally:
        stream.close()


if __name__ == "__main__":
    sys.exit(main())
