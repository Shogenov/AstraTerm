#!/bin/sh
# Use Astra 1.6's ABI-compatible interpreter, independent of python3 alternatives.
set -eu

script_path=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
source_root=$(dirname -- "$script_dir")

if [ -f "$source_root/astraterm/__main__.py" ]; then
    app_root=$source_root
elif [ -f /usr/share/astraterm/astraterm/__main__.py ]; then
    app_root=/usr/share/astraterm
else
    printf '%s\n' 'AstraTerm: файлы приложения не найдены. Повторите установку.' >&2
    exit 1
fi

runtime=
for candidate in /usr/bin/python3.5 /usr/bin/python3; do
    if [ -x "$candidate" ] && "$candidate" -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("Vte", "2.91"); from gi.repository import Gtk, Vte; import cairo' >/dev/null 2>&1; then
        runtime=$candidate
        break
    fi
done

if [ -z "$runtime" ]; then
    message='AstraTerm: не найдены совместимые Python + GTK3/VTE.
Установите пакеты из репозитория вашей Astra Linux:
python3-gi python3-gi-cairo gir1.2-gtk-3.0 gir1.2-vte-2.91
На Astra Linux 1.6 используются библиотеки для /usr/bin/python3.5.
Проверка: /usr/bin/python3.5 -c "from gi.repository import Gtk, Vte"'
    printf '%s\n' "$message" >&2
    if [ -n "${DISPLAY:-}" ] && command -v xmessage >/dev/null 2>&1; then
        xmessage -center "$message" >/dev/null 2>&1 || true
    fi
    exit 1
fi

# Insert the application before cwd/PYTHONPATH without changing the shell cwd.
exec "$runtime" -c 'import runpy, sys; sys.path.insert(0, sys.argv.pop(1)); runpy.run_module("astraterm", run_name="__main__", alter_sys=True)' "$app_root" "$@"
